# Valores deste arquivo são para DESENVOLVIMENTO LOCAL. Em produção (Render),
# nada aqui é lido: as variáveis reais ficam nas Environment Variables do
# próprio Render (ver README, seção "Deploy no Render"). Em especial,
# produção sempre usa APP_ENV=production, APP_DEBUG=false e uma APP_KEY
# própria, gerada uma única vez.

APP_NAME="Reflexões Diárias de Santa Faustina"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Em produção, use LOG_CHANNEL=stderr: é o canal que aparece no painel de
# logs do Render (que só captura stdout/stderr do container, não arquivos
# dentro dele, como storage/logs/laravel.log).

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=reflexoes
DB_USERNAME=reflexoes
DB_PASSWORD=secret
# Usado apenas pelo container MySQL (docker-compose.yml), não pelo Laravel
DB_ROOT_PASSWORD=secret
# Em produção, DB_HOST/DB_PORT/DB_USERNAME/DB_PASSWORD apontam para o MySQL
# externo configurado (o Render não tem MySQL gerenciado nativo - só
# PostgreSQL/Redis). Ver README, seção "Deploy no Render".

# Credenciais do administrador inicial usadas pelo AdminUserSeeder, só em
# ambiente local (`php artisan db:seed`). Em produção, NÃO rode seeders -
# crie o administrador com `php artisan admin:create` (prompts interativos,
# nada fica salvo em variável de ambiente nem em log).
ADMIN_NAME="Administrador"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Dados públicos do Pix exibidos na seção de doação da Home (config/donation.php)
PIX_KEY=dc25aa47-1dbf-4562-ac1f-195223e94457
PIX_RECEIVER_NAME="Breno Mol"
PIX_BANK=Bradesco
PIX_MERCHANT_CITY="SAO PAULO"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
